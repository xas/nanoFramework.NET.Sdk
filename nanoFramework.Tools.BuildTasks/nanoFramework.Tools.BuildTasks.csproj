<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net472</TargetFrameworks>
    <RootNamespace>nanoFramework.Tools</RootNamespace>
    <AssemblyName>nanoFramework.Tools.BuildTasks</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>nanoFramework.Tools.BuildTasks.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Framework" Version="18.0.2" PrivateAssets="all" ExcludeAssets="runtime">
      <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.0.2" PrivateAssets="all" ExcludeAssets="runtime">
      <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Resource processing (.resx -> .nanoresources) on .NET Framework uses GDI+ and
    WinForms (System.Drawing / System.Windows.Forms ResXResourceReader).
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <!--
    On modern .NET the GDI+ / WinForms dependencies are unavailable, so the resource
    pipeline uses cross-platform equivalents (see ProcessResourceFiles.CrossPlatform.cs):
      * SkiaSharp for bitmap decoding / RGB565 conversion (native assets for Windows,
        macOS and Linux; the Linux NoDependencies flavor avoids a fontconfig requirement)
      * System.CodeDom for strongly-typed resource class generation
  -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net472'">
    <PackageReference Include="SkiaSharp" Version="4.154.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.154.0" />
    <PackageReference Include="System.CodeDom" Version="10.0.14" />
  </ItemGroup>

  <!--
    The build task is loaded by MSBuild from the SDK package's tasks\ folder, so its
    NuGet dependencies (SkiaSharp, System.CodeDom) must sit next to the task DLL.
    Copy them to the output so the packaging project can ship them. SkiaSharp's native
    libraries land in runtimes\<rid>\native\ and are resolved by MSBuild through the
    task's .deps.json.
  -->
  <PropertyGroup Condition="'$(TargetFramework)' != 'net472'">
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

</Project>
