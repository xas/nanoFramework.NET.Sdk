<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Filled by Run-SmokeTest.ps1 with the SDK packed from this checkout. -->
    <add key="local-sdk" value="../../artifacts/smoketest" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!-- The SDK must never come from nuget.org, or the smoke test silently checks a published build. -->
  <packageSourceMapping>
    <packageSource key="local-sdk">
      <package pattern="nanoFramework.NET.Sdk" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
